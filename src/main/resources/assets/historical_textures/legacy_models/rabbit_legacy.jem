      "animations": [
        {
          "var.jc": "if(var.jc >= 1, if(is_on_ground, 0, 1), if(var.jc > 0 || !is_on_ground, min(1, var.jc + frame_time * 2), 0))",
          "var.jf": "sin(var.jc * pi)",
          "legacy_head.rx": "torad(head_pitch)",
          "legacy_head.ry": "torad(head_yaw)",
          "legacy_left_thigh.rx": "torad(var.jf * 50 - 21)",
          "legacy_right_thigh.rx": "torad(var.jf * 50 - 21)",
          "legacy_left_foot.rx": "torad(var.jf * 50)",
          "legacy_right_foot.rx": "torad(var.jf * 50)",
          "legacy_left_arm.rx": "torad(var.jf * -40 - 11)",
          "legacy_right_arm.rx": "torad(var.jf * -40 - 11)"
